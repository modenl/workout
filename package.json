{
  "name": "changqing-dongyidong",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node build/build-github-page.mjs index.html",
    "test": "node --test tests/static-workout.test.mjs tests/stickman.test.mjs tests/analytics.test.mjs",
    "build:cloudflare": "node build/build-github-page.mjs dist/cloudflare/index.html",
    "deploy": "npm run build:cloudflare && npx -y wrangler@4 d1 migrations apply workout-stats --remote && npx -y wrangler@4 deploy",
