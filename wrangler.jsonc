{
  // Cloudflare Workers static-assets deploy of the single-file page.
  // Build first: npm run build:cloudflare
  "name": "workout",
  "compatibility_date": "2026-09-24",
  "assets": { "directory": "./dist/cloudflare" },
  "workers_dev": false,
  "routes": [{ "pattern": "workout.postagi.co.uk", "custom_domain": true }]
}
